{
  "name": "tec-match-recorder",
  "version": "1.1.0",
  "description": "One-button tournament VOD station for OBS: pick the set from a start.gg bracket, record, and get a correctly named file plus a stream overlay. By Texas Esports Collective.",
  "license": "MIT",
  "author": "Texas Esports Collective",
  "private": false,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "start:headless": "node server.js --no-browser",
    "fetch-art": "node tools/fetch-icons.js portrait",
    "thumbnails": "node tools/thumbnails.js"
  },
  "keywords": [
    "obs",
    "start.gg",
    "tournament",
    "vod",
    "smash",
    "tekken",
    "street-fighter",
    "fgc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jaggers-Git/tec-match-recorder"
  },
  "bugs": {
    "url": "https://github.com/Jaggers-Git/tec-match-recorder/issues"
  },
  "homepage": "https://github.com/Jaggers-Git/tec-match-recorder#readme"
}
